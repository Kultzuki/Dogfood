<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dogfood — Hackathon Platform</title>
  <link rel="stylesheet" href="/static/css/main.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="header">
    <div class="header__inner container">
      <a href="/" class="header__brand" aria-label="Dogfood home">
        <span class="header__mark" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" role="presentation" focusable="false">
            <rect x="0" y="0" width="28" height="28" rx="7" fill="#4338ca"></rect>
            <path d="M8 18.5V9.5h4.6c2.4 0 4.1 1.5 4.1 4.5s-1.7 4.5-4.1 4.5H8Zm2.6-2.3h1.9c1.2 0 1.7-.9 1.7-2.2s-.5-2.2-1.7-2.2h-1.9v4.4Z" fill="#ffffff"></path>
            <circle cx="20" cy="19" r="2.4" fill="#a5b4fc"></circle>
          </svg>
        </span>
        <span class="header__wordmark">Dogfood</span>
      </a>
      <form class="header__search" method="get" action="/gallery" role="search" aria-label="Search projects">
        <label class="sr-only" for="site-search">Search projects</label>
        <svg class="header__search-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
        </svg>
        <input
          class="header__search-input"
          type="search"
          id="site-search"
          name="q"
          placeholder="Search projects"
          autocomplete="off"
          data-global-search
        >
        <kbd class="header__kbd" aria-hidden="true">Ctrl K</kbd>
      </form>
      <nav class="header__nav" aria-label="Primary">
        <ul class="header__nav-list">
          <li class="header__nav-item"><a href="/" class="header__nav-link">Home</a></li>
          <li class="header__nav-item"><a href="/gallery" class="header__nav-link">Gallery</a></li>
          <li class="header__nav-item"><a href="/events" class="header__nav-link">Events</a></li>
          {% if currentUser %}
          <li class="header__nav-item"><a href="/dashboard" class="header__nav-link">Dashboard</a></li>
          {% if currentUser.role == "organizer" or currentUser.role == "admin" %}
          <li class="header__nav-item"><a href="/judging" class="header__nav-link">Judging</a></li>
          <li class="header__nav-item"><a href="/results" class="header__nav-link">Results</a></li>
          {% elif currentUser.role == "judge" %}
          <li class="header__nav-item"><a href="/judging" class="header__nav-link">Judging</a></li>
          {% endif %}
          {% endif %}
        </ul>
      </nav>
      <div class="header__actions">
        {% if currentUser %}
        <a href="/dashboard" class="header__bell" aria-label="Notifications">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M10 2a5 5 0 0 0-5 5v3L3.6 12.6a.6.6 0 0 0 .5.9H16a.6.6 0 0 0 .5-.9L15 10V7a5 5 0 0 0-5-5Zm-2.5 14a2.5 2.5 0 0 0 5 0h-5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
          </svg>
        </a>
        <div class="header__user" data-dropdown>
          <button
            class="header__avatar-btn"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            data-dropdown-toggle
          >
            <span class="header__avatar" aria-hidden="true">{{ (currentUser.name or currentUser.email or "D") | truncate(1, true, "") | escape }}</span>
            <span class="header__username">{{ (currentUser.name or currentUser.email) | escape }}</span>
            <svg class="header__caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="header__dropdown" role="menu" aria-label="Account" data-dropdown-menu hidden>
            <p class="header__dropdown-meta">{{ (currentUser.name or currentUser.email) | escape }}<br><span>{{ currentUser.email | escape }} · {{ currentUser.role | escape }}</span></p>
            <a class="header__dropdown-item" href="/dashboard" role="menuitem">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="2" y="2" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect><rect x="9" y="2" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect><rect x="2" y="9" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect><rect x="9" y="9" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect></svg>
              My Projects
            </a>
            <a class="header__dropdown-item" href="/events" role="menuitem">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h7A1.5 1.5 0 0 1 13 5.5v5a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 3 10.5v-5Z" fill="none" stroke="currentColor" stroke-width="1.4"></path><path d="M3 6.5h10" stroke="currentColor" stroke-width="1.4"></path></svg>
              My Hackathons
            </a>
            {% if currentUser.role == "organizer" or currentUser.role == "admin" %}
            <a class="header__dropdown-item" href="/dashboard" role="menuitem">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2 13.5 4.5v3c0 3.2-2.3 5.2-5.5 6.5C4.8 12.7 2.5 10.7 2.5 7.5v-3L8 2Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
              Organizer Dashboard
            </a>
            {% endif %}
            <a class="header__dropdown-item" href="/account" role="menuitem">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="5.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M2.5 13.5c.6-2.4 2.8-3.6 5.5-3.6s4.9 1.2 5.5 3.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
              Account Settings
            </a>
            <form method="post" action="/logout" class="header__dropdown-logout">
              <input type="hidden" name="_csrf" value="{{ csrfToken | escape }}">
              <button class="header__dropdown-item header__dropdown-item--button" type="submit" role="menuitem">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 2.5H4A1.5 1.5 0 0 0 2.5 4v8A1.5 1.5 0 0 0 4 13.5h2M10.5 5 13.5 8l-3 3M13 8H6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                Log Out
              </button>
            </form>
          </div>
        </div>
        {% else %}
        <a href="/" class="button button--secondary button--sm">Sign In</a>
        <a href="/register" class="button button--primary button--sm header__cta">Register</a>
        {% endif %}
        <button class="header__menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Toggle navigation" data-mobile-toggle>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="header__mobile container" id="mobile-nav" data-mobile-nav hidden>
      <nav aria-label="Mobile">
        <ul class="header__mobile-list">
          <li><a href="/" class="header__mobile-link">Home</a></li>
          <li><a href="/gallery" class="header__mobile-link">Gallery</a></li>
          <li><a href="/events" class="header__mobile-link">Events</a></li>
          {% if currentUser %}
          <li><a href="/dashboard" class="header__mobile-link">Dashboard</a></li>
          {% if currentUser.role == "organizer" or currentUser.role == "admin" or currentUser.role == "judge" %}
          <li><a href="/judging" class="header__mobile-link">Judging</a></li>
          {% endif %}
          {% if currentUser.role == "organizer" or currentUser.role == "admin" %}
          <li><a href="/results" class="header__mobile-link">Results</a></li>
          {% endif %}
          <li><a href="/account" class="header__mobile-link">Account</a></li>
          {% else %}
          <li><a href="/" class="header__mobile-link">Sign In</a></li>
          <li><a href="/register" class="header__mobile-link">Register</a></li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </header>

  <main class="main" id="main-content">
    <div class="container">
      {% if flash %}
      {% if flash.kind == "success" or flash.ok %}
      <div class="alert alert--success" role="status" aria-live="polite">{{ (flash.message or flash.ok) | escape }}</div>
      {% elif flash.kind == "error" or flash.err %}
      <div class="alert alert--error" role="alert" aria-live="polite">{{ (flash.message or flash.err) | escape }}</div>
      {% else %}
      <div class="alert alert--warning" role="status" aria-live="polite">{{ (flash.message) | escape }}</div>
      {% endif %}
      {% endif %}
      {% block content %}{% endblock %}
    </div>
  </main>

  <footer class="footer">
    <div class="footer__inner container">
      <div class="footer__grid">
        <div class="footer__brand">
          <span class="footer__mark" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 28 28" role="presentation" focusable="false">
              <rect x="0" y="0" width="28" height="28" rx="7" fill="#4338ca"></rect>
              <path d="M8 18.5V9.5h4.6c2.4 0 4.1 1.5 4.1 4.5s-1.7 4.5-4.1 4.5H8Zm2.6-2.3h1.9c1.2 0 1.7-.9 1.7-2.2s-.5-2.2-1.7-2.2h-1.9v4.4Z" fill="#ffffff"></path>
              <circle cx="20" cy="19" r="2.4" fill="#a5b4fc"></circle>
            </svg>
          </span>
          <p class="footer__title">Dogfood</p>
          <p class="footer__copy">Self-hosted hackathon platform — registration, teams, judging, results.</p>
        </div>
        <nav class="footer__nav" aria-label="Footer">
          <p class="footer__heading">Explore</p>
          <ul class="footer__list">
            <li><a href="/gallery" class="footer__link">Discover projects</a></li>
            <li><a href="/events" class="footer__link">Hackathons</a></li>
            <li><a href="/dashboard" class="footer__link">Dashboard</a></li>
          </ul>
        </nav>
        <nav class="footer__nav" aria-label="Account footer">
          <p class="footer__heading">Account</p>
          <ul class="footer__list">
            <li><a href="/account" class="footer__link">Account settings</a></li>
            <li><a href="/" class="footer__link">Sign in</a></li>
            <li><a href="/register" class="footer__link">Register</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer__copy footer__copy--base">&copy; 2026 Dogfood Hackathon Platform</p>
    </div>
  </footer>
  <script src="/static/js/ui.js" defer></script>
</body>
</html>
