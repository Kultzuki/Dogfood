{% extends "layout.njk" %}
{% import "partials/nl2br.njk" as text %}

{% block content %}
<div class="card page">
  <div class="card__header">
    <h1 class="card__title">Versions — {{ project.title }}</h1>
    <p class="text-muted text-center">Append-only snapshots. Every save creates a new version.</p>
  </div>

  {% if flash %}
  <div class="alert alert--{{ flash.kind }}" role="alert">{{ flash.message }}</div>
  {% endif %}

  <div class="card__body">
    {% if versions and versions.length > 0 %}
    <ul class="flex flex-col gap-4">
      {% for v in versions %}
      <li class="card card--page">
        <div class="card__header">
          <h2 class="card__title card__title--left">Version {{ v.versionNo }}</h2>
          <p class="text-muted"><span class="badge badge--{{ v.status }}">{{ v.status }}</span> — {{ v.createdAt }}</p>
        </div>
        <div class="card__body">
          <p><strong>{{ v.title }}</strong></p>
          {% if v.tagline %}
          <p class="text-muted">{{ v.tagline }}</p>
          {% endif %}
          {% if v.description %}
          <p>{{ text.nl2br(v.description) }}</p>
          {% endif %}
          {% if v.techTags and v.techTags.length > 0 %}
          <p class="text-muted mt-2">Tags: {{ v.techTags | join(", ") }}</p>
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="empty-state">
      <p class="empty-state__title">No versions recorded.</p>
    </div>
    {% endif %}
    <p class="mt-2"><a href="/events/{{ eventId }}/projects/{{ project.id }}/edit">Back to project</a></p>
  </div>
</div>
{% endblock %}
