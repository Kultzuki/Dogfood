{% extends "layout.njk" %}

{% block content %}
<div class="card page">
  <div class="card__header card__header--split">
    <div>
      <h1 class="card__title card__title--left mb-0">Judging Hub</h1>
      <p class="text-muted">Oversee judging assignments, scoring rubrics, and evaluation progress across events.</p>
    </div>
    {% if isOrganizer %}
    <a class="button button--secondary button--sm" href="/events">Manage Events</a>
    {% endif %}
  </div>

  <div class="card__body">
    {% if isJudge and judgeAssignments and judgeAssignments.length > 0 %}
    <div class="hub-card hub-card--flush">
      <h2 class="text-lg mb-2">Your Assigned Events (Judge)</h2>
      <ul class="flex flex-col gap-2">
        {% for a in judgeAssignments %}
        <li class="flex justify-between items-center gap-2 table-row-bordered">
          <div>
            <strong>{{ a.event_name }}</strong>
            <span class="badge badge--pending ml-2">{{ a.pending_count }} pending</span>
          </div>
          <a class="button button--primary button--sm" href="/events/{{ a.event_id }}/judge">Open Scoring Queue &rarr;</a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if isOrganizer %}
    <h2 class="text-xl mb-1">Managed Events Judging</h2>
    <p class="section-desc">Track review coverage and score submissions across hackathons you manage.</p>

    {% if events and events.length > 0 %}
    <div class="event-card-list">
      {% for e in events %}
      <div class="event-card">
        <div class="event-card__header">
          <div>
            <h3 class="text-lg mb-1">
              <a class="event-card__title" href="/events/{{ e.id }}/judging-progress">{{ e.name }}</a>
            </h3>
            <div class="flex items-center gap-2">
              <span class="badge {% if e.state == 'JUDGING' %}badge--scored{% elif e.state == 'RESULTS_FINAL' or e.state == 'PUBLISHED' %}badge--success{% else %}badge{% endif %}">{{ e.state }}</span>
              <span class="text-muted text-xs">Rubric v{{ e.rubric_version or 1 }}</span>
            </div>
          </div>
          <div class="event-card__actions">
            <a class="button button--primary button--sm" href="/events/{{ e.id }}/judging-progress">Judging Progress &rarr;</a>
          </div>
        </div>

        <div class="event-card__metrics">
          <div class="event-card__metric">
            <span class="event-card__metric-val">{{ e.submitted_count }}</span>
            <span class="event-card__metric-lbl">Submitted Projects</span>
          </div>
          <div class="event-card__metric">
            <span class="event-card__metric-val">{{ e.judge_count }}</span>
            <span class="event-card__metric-lbl">Judges</span>
          </div>
          <div class="event-card__metric">
            <span class="event-card__metric-val">{{ e.score_count }}</span>
            <span class="event-card__metric-lbl">Total Reviews</span>
          </div>
          <div class="event-card__metric">
            <span class="event-card__metric-val">
              {% if e.is_finalized %}
              <span class="text-success">Finalized</span>
              {% else %}
              <span class="text-muted">Unfinalized</span>
              {% endif %}
            </span>
            <span class="event-card__metric-lbl">Results</span>
          </div>
        </div>

        <div class="event-card__footer">
          <span class="text-muted text-xs">
            Target: k=3 reviews per project with cross-judge normalization.
          </span>
          <div class="flex gap-2">
            <a class="button button--secondary button--sm" href="/events/{{ e.id }}/rubric">Rubric</a>
            <a class="button button--secondary button--sm" href="/events/{{ e.id }}/judges">Judges</a>
            <a class="button button--secondary button--sm" href="/events/{{ e.id }}/manage">Manage Event</a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">
      <p class="empty-state__title">No events to judge.</p>
      <p class="empty-state__text">Create an event and configure judging rubrics to start evaluating submissions.</p>
      <a class="button button--primary" href="/events/new">Create Event</a>
    </div>
    {% endif %}
    {% endif %}
  </div>
</div>
{% endblock %}
