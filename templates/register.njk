{% extends "layout.njk" %}
{% import "macros/forms.njk" as f %}

{% block content %}
<div class="auth-hero">
  <div class="auth-hero__grid">
    <div class="auth-hero__copy">
      <span class="auth-hero__eyebrow">One account, every event</span>
      <h1 class="auth-hero__title">Join the builder community.</h1>
      <p class="auth-hero__lede">Register once, then join teams, submit projects, and follow results across every hackathon run on this platform.</p>
      <div class="auth-hero__points">
        <p class="auth-hero__point"><span class="auth-hero__dot" aria-hidden="true"></span>Passwords are hashed; sessions expire for safety.</p>
        <p class="auth-hero__point"><span class="auth-hero__dot" aria-hidden="true"></span>Join a team with an invite link in seconds.</p>
        <p class="auth-hero__point"><span class="auth-hero__dot" aria-hidden="true"></span>Showcase your work in the public gallery.</p>
      </div>
      <div class="auth-hero__stats" aria-label="Platform highlights">
        <div class="auth-hero__stat">
          <p class="auth-hero__stat-val">Teams</p>
          <p class="auth-hero__stat-lbl">Invite links</p>
        </div>
        <div class="auth-hero__stat">
          <p class="auth-hero__stat-val">Gallery</p>
          <p class="auth-hero__stat-lbl">Public showcase</p>
        </div>
        <div class="auth-hero__stat">
          <p class="auth-hero__stat-val">Judging</p>
          <p class="auth-hero__stat-lbl">Fair rubrics</p>
        </div>
      </div>
    </div>
    <div class="card card--page auth-card">
      <div class="card__header">
        <h2 class="card__title">Create Account</h2>
      </div>

      {{ f.formError(error) }}

      <form class="form" method="post" action="/register" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken | escape }}">

        {{ f.input(id="name", name="name", label="Display name", type="text", value=values.name, error=errors.name, autocomplete="name", placeholder="Ada Lovelace", required=true) }}

        {{ f.input(id="email", name="email", label="Email address", type="email", value=values.email, error=errors.email, autocomplete="email", placeholder="you@example.com", required=true) }}

        {{ f.input(id="password", name="password", label="Password", type="password", value="", error=errors.password, autocomplete="new-password", placeholder="Password", required=true) }}

        <div class="form__actions">
          {{ f.button("Create Account") }}
        </div>
      </form>

      <div class="card__footer">
        <p class="form__link">Already have an account? <a href="/">Sign in</a></p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
