{% extends "layout.njk" %}

{% block content %}
<link rel="stylesheet" href="/static/css/judging.css">
<div class="card page">
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a class="breadcrumb__link" href="/events">Events</a>
    <span class="breadcrumb__separator">/</span>
    <a class="breadcrumb__link" href="/events/{{ event.id }}/manage">{{ event.name }}</a>
    <span class="breadcrumb__separator">/</span>
    <span class="breadcrumb__current">Scoring Rubric</span>
  </nav>

  <div class="card__header card__header--left">
    <h1 class="card__title card__title--left">Scoring Rubric Configuration</h1>
    <p class="text-muted j-page-intro">Configure the 4 weighted judging criteria. Weights must sum to exactly 100%.</p>
  </div>

  {% if error %}
  <div class="alert alert--error alert--inset" role="alert">
    <strong>Error:</strong> {{ error }}
  </div>
  {% endif %}

  <div class="card__body">
    <!-- Active Version Banner -->
    <div class="hub-card hub-card--flush">
      <div class="flex justify-between items-center mb-1">
        <strong>Active Rubric Version: v{{ activeRubric.version }}</strong>
        <span class="badge badge--success">Active</span>
      </div>
      <p class="text-muted text-xs mb-0">
        Judges score each project on a 0–100 scale per criterion. The platform computes the weighted composite server-side. Updating weights creates a new version; previously submitted scores remain immutable and preserve their original rubric version.
      </p>
    </div>

    <!-- Edit Form -->
    <form class="form form--flush" method="post" action="/events/{{ event.id }}/rubric">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div class="form__group j-rubric-row">
        <div class="j-rubric-head">
          <label class="form__label" for="technical">
            <strong>Technical Execution (Weight %)</strong>
          </label>
          <span class="text-muted j-weight-hint" id="hint-technical">Code quality, architecture, difficulty, working functionality.</span>
        </div>
        <div class="j-score-input">
          <input class="form__input" type="number" id="technical" name="technical" min="0" max="100" step="1" required value="{{ activeRubric.weights.technical }}" data-criteria="rubric-total" aria-describedby="hint-technical">
          <span class="text-muted j-scale-note">0–100</span>
        </div>
      </div>

      <div class="form__group j-rubric-row">
        <div class="j-rubric-head">
          <label class="form__label" for="innovation">
            <strong>Innovation &amp; Creativity (Weight %)</strong>
          </label>
          <span class="text-muted j-weight-hint" id="hint-innovation">Originality, novel tech use, creative problem solving.</span>
        </div>
        <div class="j-score-input">
          <input class="form__input" type="number" id="innovation" name="innovation" min="0" max="100" step="1" required value="{{ activeRubric.weights.innovation }}" data-criteria="rubric-total" aria-describedby="hint-innovation">
          <span class="text-muted j-scale-note">0–100</span>
        </div>
      </div>

      <div class="form__group j-rubric-row">
        <div class="j-rubric-head">
          <label class="form__label" for="impact">
            <strong>Impact &amp; Real-World Value (Weight %)</strong>
          </label>
          <span class="text-muted j-weight-hint" id="hint-impact">Usefulness, market or societal impact, viability.</span>
        </div>
        <div class="j-score-input">
          <input class="form__input" type="number" id="impact" name="impact" min="0" max="100" step="1" required value="{{ activeRubric.weights.impact }}" data-criteria="rubric-total" aria-describedby="hint-impact">
          <span class="text-muted j-scale-note">0–100</span>
        </div>
      </div>

      <div class="form__group j-rubric-row">
        <div class="j-rubric-head">
          <label class="form__label" for="polish">
            <strong>Polish &amp; Design (Weight %)</strong>
          </label>
          <span class="text-muted j-weight-hint" id="hint-polish">UX, visual design, demo quality, documentation.</span>
        </div>
        <div class="j-score-input">
          <input class="form__input" type="number" id="polish" name="polish" min="0" max="100" step="1" required value="{{ activeRubric.weights.polish }}" data-criteria="rubric-total" aria-describedby="hint-polish">
          <span class="text-muted j-scale-note">0–100</span>
        </div>
      </div>

      <!-- Live Total Indicator -->
      <div class="rubric-total-box">
        <span class="font-semibold text-sm">Total Weight:</span>
        <span class="font-bold text-base"><span data-output="rubric-total">100</span>% / 100%</span>
      </div>

      <div class="form__actions mt-6">
        <button class="button button--primary" type="submit">Save Rubric as Version v{{ activeRubric.version + 1 }}</button>
        <a class="button button--secondary" href="/events/{{ event.id }}/manage">Back to Manage Event</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
