{% extends "layout.njk" %}

{% block content %}
<link rel="stylesheet" href="/static/css/judging.css">
<div class="card">
  <div class="card__header">
    <div class="j-queue-head">
      <div>
        <h1 class="card__title">New Event</h1>
        <p class="text-muted j-page-intro">Create a hackathon event. You become its organizer.</p>
      </div>
      <span class="badge">Step 1 of setup</span>
    </div>
  </div>

  {% if error %}
  <div class="alert alert--error" role="alert">
    {{ error }}
  </div>
  {% endif %}



  <form class="form" method="post" action="/events/new">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="form__group">
      <label class="form__label" for="name">Event name</label>
      <input
        class="form__input"
        type="text"
        id="name"
        name="name"
        required
        maxlength="255"
        autocomplete="off"
        placeholder="Hackathon Raptors Dogfood 2026"
      >
    </div>

    <div class="form__group">
      <label class="form__label" for="description">Description</label>
      <input
        class="form__input"
        type="text"
        id="description"
        name="description"
        autocomplete="off"
        placeholder="Optional short description"
      >
      <span class="form__help">Optional. Leave blank for none.</span>
    </div>

    <div class="form__actions">
      <button class="button button--primary" type="submit">Create event</button>
    </div>
  </form>
</div>
{% endblock %}
