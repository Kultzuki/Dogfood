{% extends "layout.njk" %}

{% block content %}
<div class="card page">
  <div class="card__header">
    <h1 class="card__title">Judging Queue</h1>
    <p class="text-muted text-center">{{ scored }} of {{ total }} ({{ pct }}%)</p>
    <p class="text-muted text-center">Track scope: {{ scopeLabel }}</p>
  </div>

  {% if flash and flash.ok %}
  <div class="alert alert--success" role="alert">
    {{ flash.ok }}
  </div>
  {% endif %}
  {% if flash and flash.err %}
  <div class="alert alert--error" role="alert">
    {{ flash.err }}
  </div>
  {% endif %}

  <div class="card__body">
    {% if items and items.length > 0 %}
    <div class="progress-bar" role="progressbar" aria-valuenow="{{ scored }}" aria-valuemin="0" aria-valuemax="{{ total }}" aria-label="Judging progress">
      <span class="progress-bar__fill" style="width: {{ pct }}%;"></span>
    </div>
    <ul class="gallery-grid mt-4">
      {% for it in items %}
      <li class="card card--page project-card">
        <div class="card__header">
          <h2 class="card__title project-card__title">{{ it.projectTitle }}</h2>
          {% if it.projectTagline %}
          <p class="text-muted">{{ it.projectTagline }}</p>
          {% endif %}
        </div>
        <div class="card__body">
          <p class="project-card__meta">
            {% if it.trackName %}
            <span class="badge">Track: {{ it.trackName }}</span>
            {% else %}
            <span class="badge">Track: General</span>
            {% endif %}
            {% if it.state == "SCORED" %}
            <span class="badge badge--scored">SCORED (v{{ it.version }}, {{ it.value }})</span>
            {% else %}
            <span class="badge badge--pending">PENDING</span>
            {% endif %}
          </p>
          <p class="mt-4">
            <a class="button button--secondary button--sm" href="/judge/assignments/{{ it.assignmentId }}">Open ballot</a>
          </p>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="empty-state">
      <p class="empty-state__title">No assignments in scope.</p>
      <p class="empty-state__text">Assignments appear here once an organizer assigns this event or track to you.</p>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
