<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dogfood gallery widget</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/discover.css">
</head>
<body>
  <main class="main">
    <div class="container discover-embed">
      {% if projects and projects.length > 0 %}
      <ul class="discover-grid gallery-grid">
        {% for p in projects %}
        {% set ci = loop.index0 % 4 %}
        <li class="card card--page project-card">
          <div class="project-card__cover cover--{% if ci == 0 %}a{% elif ci == 1 %}b{% elif ci == 2 %}c{% else %}d{% endif %}" aria-hidden="true">
            <svg viewBox="0 0 400 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#ffffff" stroke-opacity="0.18" stroke-width="1"><circle cx="40" cy="30" r="24"></circle><circle cx="340" cy="90" r="36"></circle><path d="M0 100 L120 60 L240 95 L400 45"></path></g></svg>
          </div>
          <div class="card__body project-card__body">
            <h2 class="card__title project-card__title"><a href="/gallery/{{ p.id }}" target="_blank" rel="noopener">{{ p.title }}</a></h2>
            {% if p.tagline %}
            <p class="project-card__tagline text-muted">{{ p.tagline }}</p>
            {% endif %}
            {% if p.tech_tags and p.tech_tags.length > 0 %}
            <ul class="tag-list" aria-label="Tech tags">
              {% for t in p.tech_tags %}
              <li class="tag">{{ t }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            <p class="form__help mt-2">{{ p.event_name }}</p>
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="empty-state discover-empty" role="status">
        <p class="empty-state__title discover-empty__title">No submitted projects found.</p>
      </div>
      {% endif %}
    </div>
  </main>
</body>
</html>
