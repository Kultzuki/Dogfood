# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dogfood

# Server
HOST=0.0.0.0
PORT=3000

# Session secret: generate with `openssl rand -hex 32`. Never use the default in production.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# ── LOCAL / DEMO TEST ACCOUNTS ────────────────────────────────────────
# Set to 1 to seed four fixed, password-loginable demo identities
# (test.organizer / test.judgea / test.judgeb / test.participant
#  @dogfood.local, shared password) for manual browser testing.
#
# compose.yaml defaults this to 1 for the local quick-start sandbox. Set it
# to 0 (here, or in a .env file beside compose.yaml) for ANY deployment that
# is not a local sandbox — these accounts share one published password.
#
# They are NOT the official acceptance fixture identities; .dogfood.toml never
# references them. No backdoor route exists: they log in via the normal
# POST /login form with a normal scrypt password hash and a normal signed
# session cookie.
DOGFOOD_DEMO_ACCOUNTS=0

# Optional: override the shared demo password (min 8 chars).
# DOGFOOD_DEMO_PASSWORD=DogfoodTest123!
